# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Claude Code workspace
.claude/

# Heavy GLB assets — keep local, don't bloat the repo.
public/models/*.glb
# Exception: the two Vibey character models. Small enough to commit
# (453 KB + 12 MB), and we want them at stable public URLs so any
# other agent / tool / pipeline can fetch them.
!public/models/vibey.glb
!public/models/expressive-vibey.glb
# Exception: the iridescent arc (14 MB) — the "/coin" hero ornament and
# the vibe emblem in /city. A prior commit deleted its bundled copy and
# referenced this public path without ever committing the file, which
# silently broke every same-origin and cross-origin load of it. Same
# stable-URL rationale as the Vibey models above.
!public/models/iridescent-arc.glb

# Supabase CLI local cache (linked-project metadata, version files, etc.)
supabase/.temp/
supabase/.branches/

# Screenshot harness output
shots/

# Capture harness output — regenerate with scripts/dz-shot.mjs, never commit.
shots/

# Dance contact sheets — regenerate with scripts/dance-shots.mjs. They exist to
# be looked at once before a push, not to be reviewed as a diff.
.dance-shots/
